{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lonniev/dpyc-community/schemas/members.schema.json",
  "title": "DPYC Social Contract Membership Registry",
  "description": "Schema for the DPYC community membership registry (members.json).",
  "type": "object",
  "required": [
    "version",
    "updated_at",
    "members"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/member"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "member": {
      "type": "object",
      "required": [
        "npub",
        "role",
        "status",
        "member_since"
      ],
      "properties": {
        "npub": {
          "type": "string",
          "pattern": "^npub1[a-z0-9]{58}$",
          "description": "Nostr public key in bech32 format."
        },
        "role": {
          "type": "string",
          "enum": [
            "prime_authority",
            "authority",
            "operator",
            "advocate",
            "citizen"
          ],
          "description": "Member's role in the Social Contract."
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "inactive",
            "banned",
            "suspended"
          ],
          "description": "Current standing in the community. inactive: in good standing and kept on record, but not serving at present; listings leave it out."
        },
        "member_since": {
          "type": "string",
          "format": "date",
          "description": "Date the member joined (YYYY-MM-DD)."
        },
        "display_name": {
          "type": "string",
          "description": "Human-readable name or service identifier."
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service"
          },
          "description": "Services operated by this member: MCP servers, and any plain HTTP endpoints they depend on."
        },
        "upstream_authority_npub": {
          "type": [
            "string",
            "null"
          ],
          "description": "npub of the member's upstream Authority. Null for prime_authority."
        },
        "notes": {
          "type": "string",
          "description": "Free-form notes about the member."
        },
        "ban_reason": {
          "type": "string",
          "description": "Reason for ban — link to GitHub Issue."
        },
        "banned_at": {
          "type": "string",
          "format": "date",
          "description": "Date the member was banned (YYYY-MM-DD)."
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": [
        "name",
        "url",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": "string"
        },
        "transport": {
          "type": "string",
          "enum": [
            "mcp",
            "http"
          ],
          "description": "How the endpoint is reached. mcp (the default when absent): an MCP server over streamable HTTP. http: a plain web endpoint, such as a browser callback, that is not an MCP and is never probed as one."
        }
      },
      "additionalProperties": false
    }
  }
}
